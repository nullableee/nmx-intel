+    // intelfb-0009: NVAccel consumes index 4 at publish time; IOGraphics later opens this panel as index 0.
+    // When no NVIDIA display head exists, give the Intel panel its own controller group rather than leaving fFbs[0] NULL.
+    uint32_t dep = fSurfMap ? ifb_knob("nullmoth-intelfb-dep", 1) : 0;
+    if (dep) {
+        fOwnGroup = dep != 2;
-        setProperty("IOFBDependentID", 0x4E56524D00000001ull, 64);
